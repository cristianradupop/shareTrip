-state=$( (git diff HEAD -- . ':!.claude'; git ls-files --others --exclude-standard -- src e2e scripts drizzle | xargs -I{} sh -c 'echo {}; cat "{}"') 2>/dev/null | shasum | cut -d' ' -f1)
