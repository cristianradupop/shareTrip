{
  "name": "tripshare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter server-admin dev",
    "build": "pnpm --filter server-admin build",
    "start": "pnpm --filter server-admin start",
    "lint": "pnpm -r lint && eslint e2e playwright.config.ts vitest.config.mts",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "test": "vitest run --reporter=dot",
    "test:file": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "git config core.hooksPath .githooks || true",
    "db:generate": "pnpm --filter server-admin db:generate",
    "db:migrate": "pnpm --filter server-admin db:migrate",
    "db:check": "pnpm --filter server-admin db:check",
    "db:studio": "pnpm --filter server-admin db:studio",
    "db:seed-admin": "pnpm --filter server-admin db:seed-admin",
    "db:seed-demo": "pnpm --filter server-admin db:seed-demo",
    "db:setup-storage": "pnpm --filter server-admin db:setup-storage"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  }
}
