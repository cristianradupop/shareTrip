# TripTogether - environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Database (Supabase, region: Frankfurt / eu-central-1) ---
# Supabase dashboard > Connect > "Transaction pooler" (port 6543). Used by the app (Vercel).
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:6543/postgres
# Supabase dashboard > Connect > "Session pooler" (port 5432). Used by drizzle-kit (migrations, Drizzle Studio).
DIRECT_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:5432/postgres

# --- Supabase Storage (profile photos) ---
# Project Settings > Data API > Project URL
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# Project Settings > API Keys > "Secret key" (sb_secret_...). Server only, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_PHOTOS_BUCKET=profile-photos

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Local: http://localhost:3000 ; Vercel: set to the production URL
BETTER_AUTH_URL=http://localhost:3000

# --- First admin (used only by the seed script) ---
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
