{
  "name": "server-app",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./shared": "./src/shared/index.ts"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --reporter=dot",
    "test:file": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed-admin": "tsx --env-file=.env.local scripts/seed-admin.ts",
    "db:seed-demo": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "db:setup-storage": "tsx --env-file=.env.local scripts/setup-storage.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.22",
    "@supabase/supabase-js": "2.119.0",
    "better-auth": "1.7.22",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.10",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
